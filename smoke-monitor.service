[Unit]
Description=Smoke alarm audio monitor
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tomi
WorkingDirectory=%h/git/smoke-monitor
EnvironmentFile=%h/git/smoke-monitor/.env
ExecStart=%h/git/smoke-monitor/.venv/bin/python monitor.py --config config.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
