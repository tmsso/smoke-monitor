NTFY_TOPIC=change-me-to-a-secret-string
# Optional: access token for a protected topic (ntfy.sh account with a
# reserved topic, or a self-hosted ntfy server with ACLs).
# NTFY_TOKEN=tk_...
# Optional dead-man's switch: a ping URL from healthchecks.io (or similar).
# Pinged every [notification] healthcheck_interval_minutes while healthy.
# HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid
